# HPC Agent 环境变量（systemd EnvironmentFile 格式：KEY=VALUE，无 export、无引号）
# 复制为 hpc-agent.env 并按实际填写。这是供 3dix-portal 调用的并行实例，
# 与生产 hpc-portal 共用同一台头节点（同一套 Torque/文件系统/用户），
# 但使用独立端口与独立状态目录，互不干扰。

# ===== ★ Agent 鉴权（本方案的核心，务必设置）=====
# 3dix-portal 用此 token 作为可信内部调用方访问本 agent；agent 据请求头
# X-Act-As-User 指定的用户名 setuid 执行。生成：openssl rand -hex 32
# 在 3dix「HPC 节点管理」里填写的 Token 必须与此一致。
HPC_AGENT_API_TOKEN=CHANGE_ME_openssl_rand_hex_32

# ===== 会话 / JWT =====
# 本实例的按用户 JWT 登录路径 3dix 不会用到（3dix 走 agent token），
# 但仍设一个随机密钥以防直连 /auth/login。生成：openssl rand -hex 32
HPC_JWT_SECRET=CHANGE_ME_PLEASE_openssl_rand_hex_32
HPC_SESSION_TTL_MINUTES=480

# ===== 监听端口 =====
# 实际端口由 systemd ExecStart 的 --port 8001 决定；此处保持一致即可。
HPC_HOST=127.0.0.1
HPC_PORT=8001

# ===== Torque / PBS（与生产相同，因为是同一头节点）=====
HPC_PBS_POLL_INTERVAL=15
HPC_ACCOUNTING_DIR=/var/spool/torque/server_priv/accounting

# ===== 文件浏览根白名单（与生产保持一致）=====
HPC_FS_ROOTS=/caedata:/caedata/project-ext:/home

# ===== 运维白名单（冒号分隔）=====
# 谁在 agent 侧被视为管理员（可查看全量作业/机时统计、用在线终端、管提取规则）。
# 注意：3dix 调用时传入的 X-Act-As-User 用户名若在此列表，则该用户在 agent 侧
# 享有管理员视图。机时统计页要可用，对应的 3dix 用户名需在此列表中。
HPC_ADMIN_USERS=admin

# ===== 独立状态库（务必与生产不同路径，避免两实例写同一文件）=====
HPC_DB_PATH=/var/lib/hpc-portal-agent/state/portal.db

# ===== 独立临时 / 缓存目录（确保存在且可写、磁盘充足）=====
HPC_SCRATCH_DIR=/var/lib/hpc-portal-agent/scratch
HPC_D3PLOT_CACHE_DIR=/var/lib/hpc-portal-agent/d3plot
HPC_OFFICE_CACHE_DIR=/var/lib/hpc-portal-agent/office
# 打包分卷阈值（字节），默认 3.5GiB
# HPC_PACKAGE_VOLUME_BYTES=3758096384

# ===== 作业提交脚本内路径映射(head→计算节点)，与生产一致 =====
HPC_SUBMIT_PATH_MAP=/data=/caedata

# ===== d3plot 三维查看（lasso）=====
# 与后端同一 conda 环境时留空即可（用后端自身解释器，须已装 lasso）
HPC_D3PLOT_PYTHON=
HPC_D3PLOT_TIMEOUT=1800
HPC_D3PLOT_MAX_STATES=0

# ===== Office 在线预览（LibreOffice）=====
HPC_OFFICE_SOFFICE=/usr/bin/soffice
HPC_OFFICE_TIMEOUT=120

# ===== 百度网盘打包上传（Phase 2 只读阶段用不到，可暂不配置）=====
# 若后续启用打包上传，再指向本实例自己的配置文件并完成一次 OAuth 授权。
# HPC_BAIDU_CONFIG=/opt/hpc-portal-agent/backend/baidu_uploader_config.yaml
