# HPC 门户后端环境变量（systemd EnvironmentFile 格式：KEY=VALUE，无 export、无引号）
# 复制为 hpc-portal.env 并按实际填写。配置优先级：环境变量 > config/*.json > 代码默认值。

# ===== 安全（务必修改）=====
# JWT 签名密钥。生成： openssl rand -hex 32
HPC_JWT_SECRET=CHANGE_ME_PLEASE_openssl_rand_hex_32
# 会话有效期（分钟）
HPC_SESSION_TTL_MINUTES=480

# ===== 文件浏览根白名单（冒号分隔，仅这些根及子目录可访问）=====
# 填任务工作目录/数据实际所在路径，例如家目录、共享数据盘、scratch
HPC_FS_ROOTS=/caedata:/caedata/project-ext:/home

# ===== 仿真项目工作目录的根 =====
# 几何数模、网格与轻量化产物按 <根>/<属主>/<项目 id> 落盘，无需人工为每个项目指定。
# 必须落在 HPC_FS_ROOTS 白名单内，否则写入会被拒。留空=白名单第一个根下的 hpc-portal/sim。
HPC_SIM_WORKDIR_ROOT=/caedata/project-ext/hpc-portal/sim

# ===== 运维白名单（冒号分隔）=====
# 谁能用「在线终端」和管理「数据提取规则」。生产环境务必设置，勿留空（留空=全员）
HPC_ADMIN_USERS=admin

# ===== Torque / PBS =====
HPC_PBS_POLL_INTERVAL=15
HPC_ACCOUNTING_DIR=/var/spool/torque/server_priv/accounting

# ===== 节点监控（管理员）=====
# "节点监控"页用 pbsnodes -a 展示各计算节点状态，并支持一键 ssh 到节点
# 重启 pbs 服务。要求后端以 root 运行、且已配置管理节点到各计算节点的
# ssh 免密登录（以下用户身份）。
HPC_NODE_SSH_USER=root
# 重启的服务名（空格分隔），经 systemctl restart 执行。
HPC_NODE_RESTART_SERVICES=pbs_mom trqauthd
# 单次 ssh 命令超时（秒）。
HPC_NODE_SSH_TIMEOUT=30

# ===== 提交准入调度（本地排队 / 并发限流）=====
# 集群总核数上限，用于"全局核数网关"：核数占满时新提交先在门户本地排队，
# 有核释放即按优先级自动补位。0=不开全局网关（默认），此时只按"用户策略"页
# 里配置的 per-user 并发配额限流，未配置的用户不受限、行为与旧版一致。
# 想启用全局网关时填集群真实总核数（务必单独观察，影响所有用户）。
HPC_CLUSTER_TOTAL_CORES=0
# 准入调度器兜底轮询间隔（秒）。正常由"新提交"和"轮询发现任务结束"两事件即时
# 触发调度，这个间隔只是兜底防漏，一般无需改。
HPC_SUBMIT_SCHEDULER_INTERVAL=10

# ===== 试算（管理节点直跑，不进 PBS）=====
# 试算=用管理员维护的"试算模板"在管理节点直接跑一条命令，用于快速验证，
# 不占用 PBS 队列。以下为该功能的资源与巡检参数。
# 全局并发上限：同时最多几个试算在管理节点运行（超出则提交返回 409）。
# 试算应保持轻量，避免拖垮管理节点，按管理节点算力保守设置。
HPC_TRIAL_MAX_CONCURRENT=4
# 收割线程轮询间隔（秒）：多久检查一次试算进程是否已结束并回收状态。
HPC_TRIAL_REAP_INTERVAL=3

# ===== 临时 / 缓存目录（确保存在且可写、磁盘充足）=====
HPC_SCRATCH_DIR=/var/lib/hpc-portal/scratch
HPC_D3PLOT_CACHE_DIR=/var/lib/hpc-portal/d3plot
HPC_OFFICE_CACHE_DIR=/var/lib/hpc-portal/office
# 打包分卷阈值（字节），默认 3.5GiB
# HPC_PACKAGE_VOLUME_BYTES=3758096384

# ===== d3plot 三维查看（lasso）=====
# 装有 lasso-python 的 Python；与后端同一 conda 环境时留空即可（用后端自身解释器）
HPC_D3PLOT_PYTHON=
# d3plot 解析超时（秒）
HPC_D3PLOT_TIMEOUT=1800
# 大模型限制状态数（0=全部）
HPC_D3PLOT_MAX_STATES=0

# ===== Office 在线预览（LibreOffice）=====
# soffice 可执行路径；在 PATH 中可留空。CentOS: /usr/bin/soffice
HPC_OFFICE_SOFFICE=/usr/bin/soffice
HPC_OFFICE_TIMEOUT=120

# ===== 百度网盘打包上传（出站：结果上传网盘并分享）=====
# baidu_uploader 配置文件路径（含 app_id/app_key/secret 与上传/分享设置）
HPC_BAIDU_CONFIG=/opt/hpc-portal/backend/baidu_uploader_config.yaml
# 提取完成后自动上传并分享的用户白名单（冒号分隔）；留空=对所有人关闭
# HPC_NETDISK_AUTO_USERS=user07

# ===== 百度网盘数据同步（入站：客户分享目录 → 集群）=====
# 平台账号的**网页 cookie**。转存(share/transfer)没有开放接口，只能走网页私有
# 接口，故必须要它；OAuth token 只负责后半段下载。留空=入站同步整体禁用
# （前端会显示"平台未配置网盘凭据"）。
# 取法：用平台账号登录 pan.baidu.com，从浏览器 Cookie 里复制 BDUSS / STOKEN。
# 会过期：失效时同步置 auth_failed 并告警，需在此更换后重启服务。
# HPC_NETDISK_BDUSS=
# HPC_NETDISK_STOKEN=

# 中转区：转存落点根目录。批次目录为 <根>/<用户>/<分享源 id>/<批次>/
# 普通权限应用只保证能读写 /apps/<应用名>，故默认放在应用目录下。
# HPC_NETDISK_INBOX_REMOTE=/apps/HPC/inbox

# 集群落点根；留空=白名单第一个根下的 hpc-portal/netdisk-inbox（须在 FS_ROOTS 内）
# HPC_NETDISK_INBOX_ROOT=/data/hpc-portal/netdisk-inbox

# 定时轮询总开关（手动同步不受此限）。私有接口需克制调用，间隔别调太小。
# HPC_NETDISK_PULL_ENABLED=false
# HPC_NETDISK_PULL_INTERVAL=600
# HPC_NETDISK_PULL_JITTER=60
# 单次 share/transfer 的 fs_id 数上限（实测值见 docs/netdisk-inbound-sync-plan.md）
# HPC_NETDISK_PULL_BATCH=100
# 下载后校验 md5（防拿到中转区旧版本）。若实测发现百度返回的 md5 不可信则置 false
# HPC_NETDISK_PULL_VERIFY_MD5=true

# ===== 数据库（SQLite）=====
# HPC_DB_PATH=/var/lib/hpc-portal/state/portal.db

# 作业提交脚本内路径映射(head→计算节点)，本集群 /caedata 软链到 /data
HPC_SUBMIT_PATH_MAP=/data=/caedata
