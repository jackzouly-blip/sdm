# HPC 门户后端环境变量（systemd EnvironmentFile 格式：KEY=VALUE，无 export、无引号）
# 复制为 hpc-portal.env 并按实际填写。配置优先级：环境变量 > config/*.json > 代码默认值。

# ===== 安全（务必修改）=====
# JWT 签名密钥。生成： openssl rand -hex 32
HPC_JWT_SECRET=CHANGE_ME_PLEASE_openssl_rand_hex_32
# 会话有效期（分钟）
HPC_SESSION_TTL_MINUTES=480

# ===== 文件浏览根白名单（冒号分隔，仅这些根及子目录可访问）=====
# 填任务工作目录/数据实际所在路径，例如家目录、共享数据盘、scratch
HPC_FS_ROOTS=/caedata:/caedata/project-ext:/home

# ===== 运维白名单（冒号分隔）=====
# 谁能用「在线终端」和管理「数据提取规则」。生产环境务必设置，勿留空（留空=全员）
HPC_ADMIN_USERS=admin

# ===== Torque / PBS =====
HPC_PBS_POLL_INTERVAL=15
HPC_ACCOUNTING_DIR=/var/spool/torque/server_priv/accounting

# ===== 提交准入调度（本地排队 / 并发限流）=====
# 集群总核数上限，用于"全局核数网关"：核数占满时新提交先在门户本地排队，
# 有核释放即按优先级自动补位。0=不开全局网关（默认），此时只按"用户策略"页
# 里配置的 per-user 并发配额限流，未配置的用户不受限、行为与旧版一致。
# 想启用全局网关时填集群真实总核数（务必单独观察，影响所有用户）。
HPC_CLUSTER_TOTAL_CORES=0
# 准入调度器兜底轮询间隔（秒）。正常由"新提交"和"轮询发现任务结束"两事件即时
# 触发调度，这个间隔只是兜底防漏，一般无需改。
HPC_SUBMIT_SCHEDULER_INTERVAL=10

# ===== 临时 / 缓存目录（确保存在且可写、磁盘充足）=====
HPC_SCRATCH_DIR=/var/lib/hpc-portal/scratch
HPC_D3PLOT_CACHE_DIR=/var/lib/hpc-portal/d3plot
HPC_OFFICE_CACHE_DIR=/var/lib/hpc-portal/office
# 打包分卷阈值（字节），默认 3.5GiB
# HPC_PACKAGE_VOLUME_BYTES=3758096384

# ===== d3plot 三维查看（lasso）=====
# 装有 lasso-python 的 Python；与后端同一 conda 环境时留空即可（用后端自身解释器）
HPC_D3PLOT_PYTHON=
# d3plot 解析超时（秒）
HPC_D3PLOT_TIMEOUT=1800
# 大模型限制状态数（0=全部）
HPC_D3PLOT_MAX_STATES=0

# ===== Office 在线预览（LibreOffice）=====
# soffice 可执行路径；在 PATH 中可留空。CentOS: /usr/bin/soffice
HPC_OFFICE_SOFFICE=/usr/bin/soffice
HPC_OFFICE_TIMEOUT=120

# ===== 百度网盘打包上传 =====
# baidu_uploader 配置文件路径（含 app_id/app_key/secret 与上传/分享设置）
HPC_BAIDU_CONFIG=/opt/hpc-portal/backend/baidu_uploader_config.yaml

# ===== 数据库（SQLite）=====
# HPC_DB_PATH=/var/lib/hpc-portal/state/portal.db

# 作业提交脚本内路径映射(head→计算节点)，本集群 /caedata 软链到 /data
HPC_SUBMIT_PATH_MAP=/data=/caedata
